# URL:        https://github.com/christianrickert/updates

clear
echo "================================================================================"
echo "                                    🫂 Ubuntu                                   "
echo "================================================================================"
sudo apt-get update && sudo apt-get -y dist-upgrade && sudo apt-get check &&
sudo apt-get -y autoremove && sudo apt-get clean && sudo apt-get moo
echo
echo "================================================================================"
echo "                                    🦀 Rust                                     "
echo "================================================================================"
rustup self update && rustup update
echo
echo "================================================================================"
echo "                                    🐍 Python                                   "
echo "================================================================================"
update_python.py
echo
